{
  "expo": {
    "name": "NetArchitect",
    "slug": "netarchitect",
    "version": "1.0.0",

    "scheme": "netarchitect",
    "orientation": "default",
    "icon": "./assets/icon.png",

    "userInterfaceStyle": "automatic",

    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1B3C",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0C1B3C"
      }
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netarchitect.app"
    },
    "android": {
      "package": "com.netarchitect.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0C1B3C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },

    "experiments": {
      "typedRoutes": true
    },

    "plugins": ["expo-router", "expo-sqlite", "expo-sharing", "expo-web-browser"]
  }
}
