{
  "name": "netarchitect",
  "version": "1.0.0",
  "description": "Offline-first IPv4 Subnet Calculator, VLSM Allocator, Network Planner & Security Auditor",
  "author": "Justine Lance Martin (Lance0519) <justinelance0067@gmail.com>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lance0519/NetArchitect.git"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.25",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-router": "~57.0.23",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.48.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^5.1.2",
    "babel-preset-expo": "^57.0.13",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npx expo-doctor",
    "export:probe": "expo export --platform android --output-dir .export-probe --clear",
    "export:probe:web": "expo export --platform web --output-dir .export-probe-web --clear",
    "build:web": "expo export --platform web --output-dir dist --clear",
    "verify:theme": "node scripts/verify-theme.cjs",
    "verify:theme:all": "node scripts/verify-theme.cjs web && node scripts/verify-theme.cjs ios && node scripts/verify-theme.cjs android",
    "verify:bundle": "node scripts/verify-bundle.cjs",
    "verify:bundle:web": "node scripts/verify-bundle-web.cjs",
    "verify:arch": "node scripts/verify-architecture.cjs",
    "check:classes": "node scripts/check-class-order.cjs",
    "//check": "typecheck + lint + format + test + architecture/privacy guard + class-order rule + stylesheet assertion.",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run verify:arch && npm run check:classes && npm run verify:theme:all",
    "//verify": "the full release gate: everything in `check`, coverage thresholds, then real Android and web builds, then assertions against the resulting bundles.",
    "verify": "npm run check && npm run test:coverage && npm run export:probe && npm run verify:bundle && npm run export:probe:web && npm run verify:bundle:web"
  },
  "overrides": {
    "decode-uri-component": "^0.5.1"
  },
  "private": true
}
